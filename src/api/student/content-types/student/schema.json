{
  "kind": "collectionType",
  "collectionName": "students",
  "info": {
    "singularName": "student",
    "pluralName": "students",
    "displayName": "Student"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "student_id": {
      "type": "text"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "contact_number": {
      "type": "text"
    },
    "course": {
      "type": "text"
    },
    "year_level": {
      "type": "integer"
    },
    "student_status": {
      "type": "enumeration",
      "enum": [
        "Active",
        "Inactive"
      ]
    },
    "payments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::payment.payment",
      "mappedBy": "student"
    },
    "reports": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::report.report",
      "mappedBy": "student"
    }
  }
}
